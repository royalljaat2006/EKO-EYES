# =============================================================================
# Eko Dekho - environment configuration
# Copy this file to ".env" and fill in real values. NEVER commit the real .env
# =============================================================================

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma separated list of origins allowed to call the dashboard API
DASHBOARD_CORS_ORIGIN=http://localhost:5173

# --- Data source ---
# Where CSP data comes from: "excel" (local Calling Sheet.xlsx) or "google"
# (live Google Sheet). Both read the SAME "Calling Sheet New" layout.
DATA_SOURCE=excel
EXCEL_FILE_PATH=./data/Calling Sheet.xlsx
# RM/DC name -> email + mobile (the Calling Sheet has no contact details).
CONTACTS_FILE_PATH=./data/RM_DC_Contacts.xlsx

# --- Google Sheets source (only needed when DATA_SOURCE=google) ---
# The spreadsheet ID is the long id in the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# The agent reads the "Calling Sheet New" tab, range A:AD, automatically.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Service account credentials. For local dev, point to the JSON key file you
# downloaded from Google Cloud Console and shared the sheet with (as Viewer).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
# For deployment, base64-encode the whole key into one env var instead:
# e.g.  base64 -w0 service-account.json
# If both are set, the base64 var takes precedence.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# --- Alert logic ---
# Rows with Days strictly greater than this value count as "inactive"
INACTIVITY_THRESHOLD_DAYS=7

# --- Escalation ladder ---
# The agent escalates as inactivity persists. Only CSP, RM and DC are ever
# involved — escalation raises FREQUENCY, not the number of people.
# Tiers (see src/config/escalation.ts):
#   Days 3-7   Self-nudge -> CSP only, WhatsApp, daily  (person can still self-fix)
#   Days 8-15  RM         -> CSP + RM, email + WhatsApp, daily
#   Days 16-23 RM + DC    -> CSP + RM + DC, email + WhatsApp, daily
#   Days 24+   Critical   -> CSP + RM + DC, daily (urgent copy)
#
# Manager / leadership contacts are NOT in the spreadsheet, so set them here.
# Comma-separated; the Nth mobile pairs with the Nth email. Leave blank to
# disable that rung of the ladder (the tier still fires for RM/DC).
ESCALATION_MANAGER_EMAILS=
ESCALATION_MANAGER_MOBILES=
ESCALATION_LEADERSHIP_EMAILS=
ESCALATION_LEADERSHIP_MOBILES=

# The business goal. Drives the target line on the dashboard's trend chart.
TARGET_INACTIVITY_RATE=2

# --- CSP contact guardrails ---
# A CSP is a person, not a ticket queue. These limits exist so the agent cannot
# harass someone into blocking the WhatsApp channel entirely.
#
# Stop messaging a CSP after this many unanswered nudges. Messaging has failed —
# a human phone call is the next step, not a fourth text.
CSP_MAX_NUDGES=3
# Minimum days between two messages to the same CSP.
CSP_NUDGE_COOLDOWN_DAYS=3
# Terminal statuses meaning the CSP CAN actually transact (comma-separated).
# Anyone outside this list is NEVER nudged — a dead terminal is a technical
# fault, not a motivation problem, and nagging them is cruel and useless.
CSP_ACTIVE_TERMINAL_STATUSES=active

# Dead-terminal CSPs are routed here instead of being nagged.
SUPPORT_EMAILS=
SUPPORT_MOBILES=

# Inbound WhatsApp replies (Meta webhook). Lets a CSP reply HELP/STOP, which
# immediately stops automated nudges and hands the case to a human.
# Point Meta's webhook at: POST https://your-host/api/whatsapp/webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Recurring sheet refresh: refreshes the spreadsheet cache and validates it's
# readable, on a repeating schedule. Sends NO messages. Default every 20 min.
SHEET_REFRESH_CRON=*/20 * * * *
# The real send: ingest -> tier -> guardrails -> notify. Default 12:00 PM (noon).
DAILY_JOB_CRON=0 12 * * *
TIMEZONE=Asia/Kolkata
# How long fetched sheet data is cached in-memory before re-fetching (ms)
SHEET_CACHE_TTL_MS=300000

# --- Email (SMTP or Gmail API) ---
# Choose: "smtp" (default) or "gmail_api"
EMAIL_PROVIDER=smtp

# SMTP options (required if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Gmail API options (required if EMAIL_PROVIDER=gmail_api)
# Generate client ID/secret in Google Cloud Console OAuth 2.0 Credentials (Desktop type).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Generate the refresh token using: npm run gmail:auth
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=

ALERT_EMAIL_FROM="Inactivity Alerts <alerts@yourcompany.com>"

# --- WhatsApp ---
# One of: meta | twilio | goinfinito
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp)
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_API_VERSION=v21.0
# Pre-approved message template used for business-initiated notifications.
# The template must accept a single body variable ({{1}}) with the alert text.
WHATSAPP_META_TEMPLATE_NAME=inactivity_alert
WHATSAPP_META_TEMPLATE_LANG=en_US

# Twilio WhatsApp API (alternative provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must include the "whatsapp:" prefix, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Goinfinito (CERF API) WhatsApp provider (sitting on top of Meta)
CERF_API_KEY=
# Registered WhatsApp sender number with country code, e.g., 917428655377
CERF_FROM=
# Numeric template ID approved on Meta/Goinfinito, e.g., 1770836
CERF_TEMPLATE_ID=
# Optional callback webhook URL for delivery reports (DLR)
CERF_DLR_URL=

# --- Persistence ---
SQLITE_DB_PATH=./data/app.sqlite
